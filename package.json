{
  "name": "@postdockai/myagent-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi coding-agent extension for a durable myagent inbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostdockAI/pi-adapter.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.2"
  }
}
